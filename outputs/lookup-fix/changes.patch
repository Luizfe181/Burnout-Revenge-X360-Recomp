+extern "C" void BurnoutPpcMmStoreU32(uint8_t* base, uint32_t address, uint32_t value)
+{
+    if (address >= 0x7FC80000u && address < 0x7FC90000u)
+    {
+        const char* name = address == 0x7FC80714u ? "CP_RB_WPTR" : "UNKNOWN";
+        std::fprintf(stderr,
