+            "UNIMPLEMENTED command processor; submission NOT consumed\n",
+            name, address, value);
+        std::fflush(stderr);
+        std::exit(5);
+    }
+    // Recompiler may conservatively mark RAM stores near an eieio as MMIO.
+    *reinterpret_cast<volatile uint32_t*>(base + address) = __builtin_bswap32(value);
+}
 
